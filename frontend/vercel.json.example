{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-SERVICE.onrender.com/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://YOUR-SERVICE.onrender.com/actuator/:path*"
    },
    {
      "source": "/((?!api/|actuator/|assets/|models/).*)",
      "destination": "/index.html"
    }
  ]
}
