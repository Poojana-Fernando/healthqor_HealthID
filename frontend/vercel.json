{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_YOUR_RENDER_URL.onrender.com/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://REPLACE_WITH_YOUR_RENDER_URL.onrender.com/actuator/:path*"
    },
    {
      "source": "/((?!api/|actuator/|assets/|models/).*)",
      "destination": "/index.html"
    }
  ]
}
