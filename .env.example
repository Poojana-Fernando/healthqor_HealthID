MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/healthid?retryWrites=true&w=majority&authSource=admin
MONGODB_DATABASE=healthid
HEALTHID_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnop
OPENAI_API_KEY=your_openai_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
FRONTEND_ORIGIN=http://localhost:5173
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TYPE=simple
SPRING_PROFILES_ACTIVE=dev

# First-run admin bootstrap (only when no ADMIN exists in database)
ADMIN_EMAIL=admin@healthid.lk
ADMIN_PASSWORD=change_me_strong_password
ADMIN_NAME=System Admin

# Frontend (Vite reads these from the root .env via vite.config.js)
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GITHUB_CLIENT_ID=your_github_client_id
