MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/healthid?retryWrites=true&w=majority&authSource=admin
MONGODB_DATABASE=healthid
HEALTHID_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnop
OPENAI_API_KEY=your_openai_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FRONTEND_ORIGIN=http://localhost:5173
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TYPE=simple
SPRING_PROFILES_ACTIVE=dev

# First-run admin bootstrap (only when no ADMIN exists in database)
ADMIN_EMAIL=admin@healthid.lk
ADMIN_PASSWORD=change_me_strong_password
ADMIN_NAME=System Admin

# Email verification (Brevo transactional email — https://app.brevo.com)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=HealthID
EMAIL_OTP_EXPIRY_MINUTES=15
EMAIL_REVERIFY_DAYS=30
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_MAX_SENDS_PER_HOUR=3

# Phone verification (Twilio SMS — https://www.twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_OTP_EXPIRY_MINUTES=15
PHONE_RESEND_COOLDOWN_SECONDS=60
PHONE_MAX_SENDS_PER_HOUR=3

# Frontend (Vite reads these from the root .env via vite.config.js)
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your_google_client_id
