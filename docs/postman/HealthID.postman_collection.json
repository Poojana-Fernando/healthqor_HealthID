{
  "info": {
    "name": "HealthID API",
    "description": "Healthqor Health ID — assignment compliance collection (cookie auth + CSRF)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "appointmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"postman@healthid.test\",\n  \"password\": \"Password123!\",\n  \"nationalId\": \"199088888888\",\n  \"country\": \"LK\",\n  \"birthDate\": \"1990-01-01\",\n  \"bloodType\": \"O+\",\n  \"heightCm\": 170,\n  \"weightKg\": 65\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login (seed patient)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@healthid.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profile/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "Profile without auth (401/403)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profile/me"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.request.headers.remove('Cookie');"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('appointmentId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"REPLACE_WITH_DOCTOR_ID\",\n  \"scheduledAt\": \"2026-07-01T10:00:00Z\",\n  \"notes\": \"Postman booking\"\n}"
            },
            "url": "{{baseUrl}}/api/appointments"
          }
        },
        {
          "name": "List My Appointments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/appointments/mine"
          }
        },
        {
          "name": "Get Appointment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "Update Appointment",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated via Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }],
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@healthid.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Paginated Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?page=0&size=20&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          }
        },
        {
          "name": "Paginated Audit Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/audit-logs?page=0&size=50&sort=timestamp,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "audit-logs"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "50" },
                { "key": "sort", "value": "timestamp,desc" }
              ]
            }
          }
        }
      ]
    }
  ]
}
